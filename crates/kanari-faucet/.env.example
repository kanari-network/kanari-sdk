# Local environment variables for kanari-faucet
# WARNING: Do NOT commit sensitive values to source control.
# Set your Dev wallet password here for local use only.
KANARI_PASSWORD=testpassword

# --- Web USD faucet (crates/kanari-rpc-server/src/transaction/faucet.rs) ---
# The node exposes kanari_requestUsdFaucet (fixed 100 USD as 2x50 objects)
# only when a sponsor key is configured. The sponsor pays claim gas, so fund
# it once with a little KANARI. Devnet only: never use a funded mainnet key.
# FAUCET_SPONSOR_KEY=<ed25519-private-key-hex>
# Per-address cooldown in seconds.
# FAUCET_COOLDOWN_SECS=3600
