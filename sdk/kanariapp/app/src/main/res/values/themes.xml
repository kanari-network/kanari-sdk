<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the Compose light scheme so launch never
         flashes a stock grey/white behind the first frame. -->
    <style name="Theme.KanariApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kanari_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
