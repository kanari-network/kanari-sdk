<?xml version="1.0" encoding="utf-8"?>
<!-- Wallet app: NEVER back up key material or sessions (API 31+ rules).
     Same rationale as backup_rules.xml: Tink keyset, encrypted wallet store
     and live zkLogin sessions must not leave the device. Re-import from
     mnemonic on a new device.
     See https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="kanari_keyset.xml"/>
        <exclude domain="file" path="datastore/"/>
        <exclude domain="file" path="zklogin/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="kanari_keyset.xml"/>
        <exclude domain="file" path="datastore/"/>
        <exclude domain="file" path="zklogin/"/>
    </device-transfer>
</data-extraction-rules>
